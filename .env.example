# Backend Alternova - Variables de Entorno
# Copia este archivo como .env y configura tus valores

# ===========================================
# CONFIGURACIÓN GENERAL
# ===========================================
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ===========================================
# BASE DE DATOS
# ===========================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=alternova_db
DB_USER=alternova_user
DB_PASSWORD=alternova_password
DB_HOST=localhost
DB_PORT=5432

# ===========================================
# REDIS (Para Celery y Cache)
# ===========================================
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# ===========================================
# CELERY
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True

# ===========================================
# EMAIL
# ===========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Backend Alternova <noreply@alternova.com>

# ===========================================
# JWT
# ===========================================
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=300
JWT_REFRESH_TOKEN_LIFETIME=86400
JWT_ALGORITHM=HS256

# ===========================================
# ARCHIVOS ESTÁTICOS Y MEDIA
# ===========================================
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log

# ===========================================
# SEGURIDAD
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# MONITOREO
# ===========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ===========================================
# DESARROLLO (Solo para desarrollo local)
# ===========================================
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# DB_HOST=localhost
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
